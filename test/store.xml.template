<?xml version="1.0" encoding="UTF-8" ?>
<!-- Persistent Store. Placeholders: @LOCAL_CIDR@

     mcs_demo uses port 12801 on interface .4; lbmrd uses 12801
     on interface .3. Those are distinct sockets. This test uses
     one interface, so the Store is moved to 12901 to avoid a
     collision with lbmrd. -->
<ume-store version="1.3">
  <daemon>
    <web-monitor>*:12811</web-monitor>
    <log type="console"/>
    <pidfile>store.pid</pidfile>
    <xml-config application-name="store1">um.xml</xml-config>
  </daemon>

  <stores>
    <store name="store_topic1" interface="@LOCAL_CIDR@" port="12901">
      <ume-attributes>
        <option type="lbm-context" name="monitor_appid" value="store_appid_topic1"/>
        <option type="store" name="disk-cache-directory" value="cache"/>
        <option type="store" name="disk-state-directory" value="state"/>
        <option type="store" name="context-name" value="store_topic1"/>
      </ume-attributes>
      <topics>
        <topic pattern="topic1" type="direct">
          <ume-attributes>
            <option type="store" name="repository-allow-receiver-paced-persistence" value="1"/>
            <option type="store" name="source-flight-size-bytes-maximum" value="1999999999"/>
            <option type="store" name="repository-allow-ack-on-reception" value="1"/>
            <option type="store" name="repository-disk-write-delay" value="1500"/>
            <option type="store" name="repository-type" value="disk"/>
            <option type="store" name="repository-size-threshold" value="141000000"/>
            <option type="store" name="repository-size-limit" value="165000000"/>
            <option type="store" name="repository-disk-file-size-limit" value="8589934592"/>
            <option type="store" name="stability-ack-minimum-number" value="64"/>
          </ume-attributes>
        </topic>
      </topics>
    </store>
  </stores>
</ume-store>
